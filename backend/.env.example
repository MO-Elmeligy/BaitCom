PORT=3000
DATABASE_URL=postgres://postgres:postgres@localhost:5432/bayt_co
# Development-only demo account. Dev session endpoints are disabled in production.
DEV_USER_PHONE=+200000000001
DEV_USER_NAME=مستخدم تجريبي

# Set this to the Firebase project ID. The server uses Application Default Credentials.
FIREBASE_PROJECT_ID=your-firebase-project-id
CORS_ORIGIN=https://your-web-app.example.com
CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret
